---
---

<div id="prologue" class="prologue-overlay">
  <canvas id="prologue-hearts" class="prologue-hearts"></canvas>

  <!-- 3D 爱心粒子 -->
  <div id="prologue-morph" class="prologue-morph"></div>

  <!-- 第 1 幕：大爱心 -->
  <div class="prologue-scene is-active">
    <p class="prologue-sub">这是一份 · 为你准备的礼物</p>
  </div>

  <!-- 第 2 幕：好看的「生日快乐」 -->
  <div class="prologue-scene prologue-scene--center">
    <p class="birthday-en">Happy Birthday</p>
    <h2 class="birthday-text">
      <span class="char">生</span><span class="char">日</span><span class="char">快</span><span class="char">乐</span>
    </h2>
    <div class="birthday-divider">
      <span class="divider-line"></span>
      <span class="divider-icon">❦</span>
      <span class="divider-line"></span>
    </div>
    <p class="birthday-greeting">写给 · 最特别的你</p>

    <span class="deco-star deco-star-1">✨</span>
    <span class="deco-star deco-star-2">⭐</span>
    <span class="deco-star deco-star-3">💫</span>
  </div>

  <!-- 第 3 幕 -->
  <div class="prologue-scene prologue-scene--center">
    <h2 class="birthday-text">生日快乐</h2>
    <p class="birthday-name">XXX</p>
  </div>

  <div class="prologue-hint">点击切换</div>
  <div class="prologue-indicator">
    <span class="prologue-dot active"></span>
    <span class="prologue-dot"></span>
    <span class="prologue-dot"></span>
  </div>
</div>
